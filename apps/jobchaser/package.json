{
  "name": "@jobchaser/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @jobchaser/web --dir . dev",
    "dev:api": "pnpm --filter @jobchaser/api --dir . dev",
    "dev": "pnpm --filter \"@jobchaser/*\" --dir . --parallel dev",
    "cdd:api": "pnpm --filter @jobchaser/api run cdd",
    "cdd:web": "pnpm --filter @jobchaser/web run cdd",
    "cdd:domain": "pnpm --filter @jobchaser/domain run cdd",
    "cdd": "pnpm -r --parallel run cdd | sed \"s/^\\([^ ]*\\) cdd:/$(printf '\\033[35m')\\1:$(printf '\\033[0m')/\"",
    "db:shell": "PGPASSFILE=.pgpass psql -h localhost -p 5432 -U jc_user jobchaser_db"
  },
  "devDependencies": {
    "@studio/cdd-monitor": "workspace:*"
  }
}
